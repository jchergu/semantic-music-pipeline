# MinIO no longer publishes images to Docker Hub or quay.io (both return
# "denied"/"unauthorized" as of 2026-10), so build the last upstream release
# from source. The source repo is archived but still exists.
FROM golang:1.24-bookworm AS build
ARG MINIO_TAG=RELEASE.2025-10-15T17-29-55Z
RUN git clone --depth 1 --branch ${MINIO_TAG} https://github.com/minio/minio /src
WORKDIR /src
RUN CGO_ENABLED=0 go build -trimpath -o /minio .

FROM debian:bookworm-slim
# curl is needed by the compose healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /minio /usr/local/bin/minio
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
